# ==============================================================================
# Git Ignore - FastAPI & Python Application
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# SQLite & Application Database Files
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Unit Tests & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
